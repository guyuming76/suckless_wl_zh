<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM 'https://www.gentoo.org/dtd/metadata.dtd'>
<pkgmetadata>
	<maintainer type="person">
		<email>gu_yu_ming@139.com</email>
	</maintainer>
	<use>
		<flag name="X">build with xwayland (rootless; 与 Xwayland.sh 的 rootful 模式互斥)</flag>
		<flag name="foot">install foot terminal emulator</flag>
		<flag name="bemenu">install bemenu</flag>
		<flag name="wmenu">install wmenu (wayland dmenu)</flag>
		<flag name="seatd">pull in seatd for seat management (无用 systemd/elogind 时的非 root 启动)</flag>
		<flag name="xwlclip">install xwlclip, rootful Xwayland 与 Wayland 之间的剪贴板桥 (Xwayland.sh 会用它)</flag>
		<flag name="fcitx">install fcitx for Chinese input</flag>
		<flag name="handwrite">build the zwp_handwrite_v1 protocol (手写输入) and pull in app-i18n/fcitx-handwrite</flag>
		<flag name="grim">install grim for screenshot</flag>
		<flag name="imv">install imv as image viewer</flag>
		<flag name="mpv">install mpv as video player</flag>
		<flag name="rfm">install rfm as file manager</flag>
		<flag name="wf-recorder">install wf-recorder as screen recorder</flag>
		<flag name="wl-clipboard">install wl-clipboard</flag>
	</use>
</pkgmetadata>
